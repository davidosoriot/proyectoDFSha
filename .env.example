# Copiar a .env y rellenar. .env NO se commitea.
#
# PUBLIC_IP: IP publica de la maquina (EC2 u otra). Es la IP que el ControlNode
# le entregara al cliente para que suba/baje bloques directo a los DataNodes.
# Con "localhost" o el nombre del contenedor NO funciona desde fuera del host.
PUBLIC_IP=203.0.113.42

# Identidad del dominio. Para la segunda EC2 (si corre domain-B) cambiar aqui.
DOMAIN_ID=domain-A

# Secretos de autenticacion. Generar en produccion con `openssl rand -hex 32`.
JWT_SECRET=cambia-esto-en-produccion-min-32-bytes
DATANODE_KEY=cambia-esta-api-key
FEDERATION_KEY=cambia-esta-federation-key

# Cifrado en reposo de los DataNodes. Hex de 64 chars (= 32 bytes = 256 bits).
# Vacio = sin cifrado.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
